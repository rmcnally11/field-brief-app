# Copy to .env.local for local work. Never commit real values.

# Hobby door for compare / morning / species / method / season / subscribers.
# Leave unset to use the shipped default.
# SITE_PASSWORD=

# The list — Airtable PAT scoped to the Field Brief base only.
# Create at https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write
# Full steps: AIRTABLE.md
# AIRTABLE_API_KEY=

# The stamp — sends mail. Not the subscriber list.
# RESEND_API_KEY=
# RESEND_FROM=Field Brief <brief@your-verified-domain.com>

# Optional: operator addresses that receive every desk.
# SUBSCRIBER_EMAILS=

# Optional: protect /api/cron/* if you expose it.
# CRON_SECRET=
