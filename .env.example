# Copy to .env.local for local work. Never commit real values.

# Shared word for the operator list only (/subscribers). The instrument is public.
# Leave unset to use the shipped default.
# SITE_PASSWORD=

# Public origin for cards, tweets, and mail links.
# NEXT_PUBLIC_SITE_URL=https://onthiswater.com

# The list — Airtable PAT scoped to the Field Brief base only (rename the base in Airtable if you want).
# Create at https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write
# Full steps: AIRTABLE.md
# AIRTABLE_API_KEY=

# The stamp — sends mail. Not the subscriber list.
# RESEND_API_KEY=
# RESEND_FROM=On This Water <line@onthiswater.com>

# Optional: operator addresses that receive every desk.
# SUBSCRIBER_EMAILS=

# Optional: protect /api/cron/* if you expose it.
# CRON_SECRET=
